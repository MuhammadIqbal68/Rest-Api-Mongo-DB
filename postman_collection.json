{
  "info": {
    "_postman_id": "a8f3e9b1-7c2d-4e5f-9a1b-3c4d5e6f7a8b",
    "name": "Notes REST API — MongoDB + Mongoose",
    "description": "Postman Collection for testing full RESTful CRUD operations (GET, POST, PUT, DELETE) on the Node.js Express Notes API backed by MongoDB Atlas via Mongoose. Note: IDs are now MongoDB ObjectIds (e.g., 64a1b2c3d4e5f6a7b8c9d0e1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "noteId",
      "value": "<paste-a-valid-mongodb-objectid-here>",
      "type": "string",
      "description": "Replace with an actual note _id from your database after creating a note."
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Check if API service and MongoDB connection are live."
      }
    },
    {
      "name": "1. GET All Notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "Retrieve all stored notes from MongoDB [200 OK]."
      }
    },
    {
      "name": "2. GET Single Note by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "{{noteId}}"
          ]
        },
        "description": "Retrieve a specific note by MongoDB ObjectId [200 OK]."
      }
    },
    {
      "name": "3. GET Note — 404 Not Found",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/64a000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "64a000000000000000000000"
          ]
        },
        "description": "Test requesting a non-existent MongoDB ObjectId [404 Not Found]."
      }
    },
    {
      "name": "4. POST Create Note (Success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && (jsonData.data.id || jsonData.data._id)) {",
              "    pm.collectionVariables.set('noteId', jsonData.data.id || jsonData.data._id);",
              "    console.log('Set noteId to: ' + (jsonData.data.id || jsonData.data._id));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Building APIs with Express.js & MongoDB\",\n  \"content\": \"Express simplifies routing, middleware, and request processing. Mongoose provides elegant MongoDB schema-based modeling.\",\n  \"category\": \"Backend\",\n  \"tags\": [\"express\", \"nodejs\", \"mongodb\", \"mongoose\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "Create a new note and automatically save the returned ID to {{noteId}} [201 Created]."
      }
    },
    {
      "name": "5. POST Create Note — 400 Bad Request (Validation Error)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"content\": \"This should fail because the title is empty.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "Test input validation middleware by submitting an empty title [400 Bad Request]."
      }
    },
    {
      "name": "6. PUT Update Note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Note Title via Mongoose\",\n  \"content\": \"This note content has been updated via a PUT request to MongoDB.\",\n  \"category\": \"General\",\n  \"tags\": [\"updated\", \"mongoose\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "{{noteId}}"
          ]
        },
        "description": "Update an existing note by MongoDB ObjectId [200 OK]."
      }
    },
    {
      "name": "7. DELETE Note",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notes",
            "{{noteId}}"
          ]
        },
        "description": "Remove a note by MongoDB ObjectId [200 OK]."
      }
    }
  ]
}
